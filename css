/* General Reset */
body, h1, p, button {
  margin: 0;
  padding: 0;
  font-family: 'Arial', sans-serif;
}

/* Center the content */
body {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background-color: #ffebee; /* Light pink background */
}

.container {
  text-align: center;
  background-color: #fff;
  padding: 30px;
  border-radius: 15px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  max-width: 90%;
}

h1 {
  font-size: 28px;
  color: #e91e63; /* Romantic pink */
  margin-bottom: 20px;
}

p {
  font-size: 18px;
  color: #555;
  margin-bottom: 20px;
}

.buttons {
  display: flex;
  justify-content: center;
  gap: 10px;
}

button {
  padding: 10px 20px;
  font-size: 18px;
  color: #fff;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: transform 0.2s ease, background-color 0.3s ease;
}

#yesBtn {
  background-color: #e91e63; /* Romantic pink */
}

#noBtn {
  background-color: #757575; /* Gray */
}

button:hover {
  transform: scale(1.05);
}

.hidden {
  display: none;
}

#response {
  font-size: 24px;
  color: #e91e63;
  margin-top: 20px;
}

#signature {
  font-size: 16px;
  color: #e91e63;
  margin-top: 30px;
  font-style: italic;
}
